<Page x:Class="CodeTracker.Views.DashBoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CodeTracker.Views"
      xmlns:helpers="clr-namespace:CodeTracker.Helpers"
      mc:Ignorable="d"
      xmlns:vm="clr-namespace:CodeTracker.ViewModels"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Dashboard">
    <Page.DataContext>
        <vm:DashBoardViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2196F3" CornerRadius="10" Padding="30" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Current Session" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                <TextBlock Text="{Binding CurrentSessionDisplay}" FontSize="16" Foreground="White" Margin="0,0,0,10"/>

                <TextBlock Text="{Binding ElapsedTimeDisplay}" FontSize="48" FontWeight="Bold" Foreground="White"
                          HorizontalAlignment="Center" Margin="0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="{Binding CurrentSession.LanguagesString}" FontSize="14" Foreground="White"
                              Visibility="{Binding HasActiveSession, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Start New Session" Command="{Binding ShowNewSessionDialogCommand}"
                           Width="150" Height="40" Margin="5" FontSize="14"
                           Visibility="{Binding HasActiveSession, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    <Button Content="Pause" Command="{Binding PauseSessionCommand}"
                           Width="100" Height="40" Margin="5" FontSize="14"
                           Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button Content="Resume" Command="{Binding ResumeSessionCommand}"
                           Width="100" Height="40" Margin="5" FontSize="14" Background="#4CAF50" Foreground="White"
                           Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button Content="Stop" Command="{Binding StopSessionCommand}"
                           Width="100" Height="40" Margin="5" FontSize="14" Background="#F44336" Foreground="White"
                           Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10" Background="White" Padding="20"
               Visibility="{Binding ShowNewSessionDialog, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Start New Session" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Text="Session Title" FontSize="14" Margin="0,0,0,5"/>
                <TextBox Text="{Binding SessionTitle, UpdateSourceTrigger=PropertyChanged}"
                        Height="35" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Project (Optional)" FontSize="14" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <ComboBox ItemsSource="{Binding Projects}"
                             SelectedValue="{Binding SelectedProjectId}"
                             DisplayMemberPath="Name" SelectedValuePath="ProjectId"
                             Width="300" Height="35" FontSize="14"/>
                    <Button Content="New Project" Command="{Binding ShowNewProjectDialogCommand}"
                           Width="120" Height="35" Margin="10,0,0,0" FontSize="14"/>
                </StackPanel>

                <TextBlock Text="Languages" FontSize="14" Margin="0,0,0,5"/>
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                    <ItemsControl ItemsSource="{Binding AvailableLanguages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                         Command="{Binding DataContext.ToggleLanguageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                         CommandParameter="{Binding}"
                                         Margin="5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Cancel" Command="{Binding CancelSessionCommand}"
                           Width="100" Height="40" Margin="5" FontSize="14"/>
                    <Button Content="Start" Command="{Binding StartSessionCommand}"
                           Width="100" Height="40" Margin="5" FontSize="14" Background="#2196F3" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10" Background="White" Padding="20"
               Visibility="{Binding ShowNewProjectDialog, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Create New Project" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Text="Project Name" FontSize="14" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"
                        Height="35" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Description (Optional)" FontSize="14" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NewProjectDescription, UpdateSourceTrigger=PropertyChanged}"
                        Height="100" FontSize="14" Margin="0,0,0,15" TextWrapping="Wrap" AcceptsReturn="True"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Cancel" Command="{Binding CancelProjectCommand}"
                           Width="100" Height="40" Margin="5" FontSize="14"/>
                    <Button Content="Create" Command="{Binding CreateProjectCommand}"
                           Width="100" Height="40" Margin="5" FontSize="14" Background="#2196F3" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
