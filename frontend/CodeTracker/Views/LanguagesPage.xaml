<Page x:Class="CodeTracker.Views.LanguagesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CodeTracker.Views"
      xmlns:helpers="clr-namespace:CodeTracker.Helpers"
      xmlns:vm="clr-namespace:CodeTracker.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Languages">
    <Page.DataContext>
        <vm:LanguagesViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Language Statistics" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <ListView ItemsSource="{Binding LanguageStats}" SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Language" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Sessions" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SessionCount}" FontSize="14" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Total Time" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedTotalTime}" FontSize="16" FontWeight="Bold" Foreground="#2196F3"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Actions" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="View Sessions"
                                           Command="{Binding DataContext.ViewLanguageSessionsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}"
                                           Width="100" Height="30" FontSize="11"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

        <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10" Background="White"
               Padding="20" Margin="20,0,0,0" Width="400"
               Visibility="{Binding ShowLanguageSessions, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Sessions using " FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedLanguage.Name}" FontSize="20" FontWeight="Bold" Foreground="#2196F3"/>
                    <Button Content="✕" Command="{Binding CloseSessionsViewCommand}"
                           Width="30" Height="30" Margin="10,0,0,0" FontWeight="Bold"
                           HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Sessions: " FontSize="14"/>
                    <TextBlock Text="{Binding SelectedLanguage.SessionCount}" FontSize="14" FontWeight="Bold" Margin="5,0,0,0"/>
                </StackPanel>

                <TextBlock FontSize="14" Margin="0,0,0,20">
                    <Run Text="Total Time: "/>
                    <Run Text="{Binding SelectedLanguage.FormattedTotalTime}" FontWeight="Bold" Foreground="#2196F3"/>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LanguageSessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10" Background="#F5F5F5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <TextBlock FontSize="12" Foreground="#666">
                                            <Run Text="Duration: "/>
                                            <Run Text="{Binding FormattedDuration}" FontWeight="Bold"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ProjectName}" FontSize="11" Foreground="#888" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding LanguagesString}" FontSize="11" Foreground="#888"/>
                                        <TextBlock Text="{Binding TimeStarted, StringFormat='dd/MM/yyyy HH:mm'}" FontSize="11" Foreground="#888"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10" Background="White" Padding="20" Margin="20,0,0,0">
            <StackPanel>
                <TextBlock Text="Language Distribution" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                    <ItemsControl ItemsSource="{Binding ChartData}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,15">
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" Margin="5,0,0,0">
                                            <Run Text="{Binding Percentage, StringFormat='{}{0:F1}%'}"/>
                                        </TextBlock>
                                    </Grid>
                                    <Grid Height="25">
                                        <Border Background="#F0F0F0" CornerRadius="3"/>
                                        <Border HorizontalAlignment="Left" CornerRadius="3">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Color}"/>
                                            </Border.Background>
                                            <Border.Width>
                                                <Binding Path="Percentage">
                                                    <Binding.Converter>
                                                        <helpers:PercentageToWidthConverter MaxWidth="300"/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </Border.Width>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
